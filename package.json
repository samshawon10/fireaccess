{
  "name": "fireaccess",
  "version": "1.0.3",
  "description": "Firebase Admin authentication, MongoDB user sync, RBAC, permissions, and audit logging for Express.js.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target node20",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "audit": "npm audit --omit=dev",
    "ci": "npm run lint && npm run typecheck && npm test && npm pack --dry-run",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run ci",
    "publish:public": "npm publish --access public",
    "publish:provenance": "npm publish --access public --provenance"
  },
  "keywords": [
    "firebase",
    "firebase-admin",
    "firebase-auth",
    "express",
    "mongodb",
    "mongoose",
    "rbac",
    "permissions",
    "authorization",
    "authentication",
    "access-control",
    "express-middleware",
    "audit-log",
    "typescript",
    "nodejs"
  ],
  "author": "Sam Shawon",
  "license": "MIT",
  "homepage": "https://github.com/samshawon10/fireaccess",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samshawon10/fireaccess.git"
  },
  "bugs": {
    "url": "https://github.com/samshawon10/fireaccess/issues"
  },
  "peerDependencies": {
    "express": ">=4.18.0 || >=5.0.0",
    "firebase-admin": ">=13.0.0",
    "mongoose": ">=8.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "express": "^4.18.3",
    "firebase-admin": "^13.10.0",
    "mongoose": "^8.0.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "supertest": "^7.1.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
