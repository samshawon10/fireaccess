{
  "name": "@fireaccess/express-middleware",
  "version": "1.1.0",
  "private": true,
  "description": "Compatibility package forwarding to @fireaccess/express-adapter.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node init && tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target node20",
    "clean": "rimraf dist",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fireaccess/express-adapter": "workspace:*"
  }
}
