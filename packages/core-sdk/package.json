{
  "name": "fireaccess",
  "version": "1.1.0",
  "description": "Firebase Admin authentication, MongoDB user sync, RBAC, permissions, audit logging, and Express middleware for MERN apps.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node init && tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --target node20",
    "clean": "rimraf dist",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "firebase",
    "firebase-admin",
    "express",
    "mongodb",
    "mongoose",
    "rbac",
    "permissions",
    "authorization",
    "authentication",
    "audit-log",
    "typescript"
  ],
  "peerDependencies": {
    "express": ">=4.18.0 || >=5.0.0",
    "firebase-admin": ">=13.0.0",
    "mongoose": ">=8.0.0"
  },
  "dependencies": {
    "@fireaccess/types": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "vitest": "^2.1.8"
  }
}
